# Paths are resolved from the repository root, regardless of the working directory.
VOICE_ROUTER_DATASET_PATH=voice_router_dataset/case_2/voice_router_dataset
VOICE_ROUTER_PROVIDER=openai_compatible
VOICE_ROUTER_MODEL=gpt-4.1-mini
VOICE_ROUTER_BASE_URL=https://api.openai.com/v1
# Alternatively, set OPENAI_API_KEY. Never put a real key in this example file.
VOICE_ROUTER_API_KEY=
VOICE_ROUTER_POLICY_VERSION=uncertainty-v1
